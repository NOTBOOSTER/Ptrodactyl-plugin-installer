{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "ptrodactyl-plugin-installer",
    "name": "Ptrodactyl Plugin Installer",
    "version": "2.0.0",
    "description": "Search and install Minecraft plugins from Modrinth, SpigotMC, CurseForge, and Hangar directly from the panel.",
    "author": "StrayStudios (Developer: Bhaskar)",
    "icon": "puzzle",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": "^2.0.0-beta.4",
        "php": "^8.3"
    },
    "provider": "MinecraftPluginInstaller\\MinecraftPluginInstallerProvider",
    "autoload": {
        "MinecraftPluginInstaller\\": "src"
    },
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "ppi",
        "screens": [
            {
                "id": "plugins",
                "area": "server",
                "path": "plugins",
                "nav": {
                    "label": "Plugins",
                    "icon": "puzzle",
                    "order": 1
                },
                "permission": [
                    "file.create",
                    "file.update"
                ],
                "when": {
                    "eggFeatures": {
                        "any": [
                            "eula",
                            "java_version"
                        ]
                    }
                }
            }
        ]
    }
}
